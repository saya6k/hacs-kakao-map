#!/usr/bin/env bash
# Run the test suite against the pre-release Home Assistant this integration
# targets (2026.8.0b0), using the vendored harness in tests/vendor/ instead of
# pytest-homeassistant-custom-component (phacc is generated from one exact
# released HA and breaks against anything newer — see tasks/plan.md T13 for
# why). Restores the stable pip-installed homeassistant afterwards so
# `scripts/test` keeps working normally.
#
# Delete this script (and tests/vendor/) once phacc ships a release tracking
# HA >= 2026.8 — check `pip show pytest-homeassistant-custom-component`'s
# `ha_version` file / Requires line, then go back to plain `scripts/test`.
set -euo pipefail

cd "$(dirname "$0")/.."

# Keep in sync with hacs.json's `homeassistant` floor.
HA_PRERELEASE=2026.8.0b0
# Read phacc's exact required homeassistant version (not our floor pin) so
# EXIT restores to a version phacc actually supports.
STABLE_PIN=$(python3 -c "
import importlib.metadata as m
for r in m.requires('pytest-homeassistant-custom-component') or []:
    if r.startswith('homeassistant=='):
        print(r.split('==')[1])
        break
")

echo "── installing homeassistant==$HA_PRERELEASE ────────"
pip install --no-deps "homeassistant==$HA_PRERELEASE"

echo "── ruff ────────────────────────────────────────────"
ruff check .

echo "── pytest (phacc plugin disabled) ──────────────────"
trap 'echo "── restoring homeassistant==$STABLE_PIN ────────────"; pip install --no-deps "homeassistant==$STABLE_PIN"' EXIT
pytest -p no:homeassistant "$@"
